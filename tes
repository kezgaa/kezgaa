from PIL import Image, ImageDraw, ImageFont

# Create image
w, h = 1024, 1024
img = Image.new("RGB", (w, h), "#f7f3e8")
draw = ImageDraw.Draw(img)

# Yellow circle
circle_radius = 350
circle_center = (w//2, h//2)
draw.ellipse(
    [
        circle_center[0]-circle_radius,
        circle_center[1]-circle_radius,
        circle_center[0]+circle_radius,
        circle_center[1]+circle_radius
    ],
    fill="#f2b61f"
)

# Text "gege"
try:
    font = ImageFont.truetype("DejaVuSans-Bold.ttf", 220)
except:
    font = ImageFont.load_default()

text = "gege"
text_w, text_h = draw.textsize(text, font=font)
draw.text(
    ((w-text_w)//2, (h-text_h)//2),
    text,
    fill="#0b2344",
    font=font
)

# Save
path = "/mnt/data/gege_logo.png"
img.save(path)

path
